generator client {
  provider = "prisma-client-js"
}
datasource db {
  provider = "postgresql"
}
model User {
  id String @id
  name String
  username String?
  preferredLanguage String? @db.VarChar(2)
  referrerId String?
  agreementVersion String?
  agreementAcceptedAt DateTime?
  selectedTariffId String? @db.VarChar(64)
  selectedTariff GpuCatalog? @relation("SelectedTariff", fields: [selectedTariffId], references: [id])
  selectedTariffAt DateTime?
  createdAt DateTime @default(now())
  requests RentalRequest[]
  tickets Ticket[]
  entries LedgerEntry[]
  leases UserLease[]
  offerAcceptances OfferAcceptance[]
  tonWallet TonWallet?
  tonProofChallenges TonProofChallenge[]
  deposits TonDeposit[]
  walletLedger WalletLedger[]
  @@index([referrerId])
  @@index([selectedTariffId])
}
model RentalRequest {
  id String @id @default(uuid())
  userId String
  user User @relation(fields: [userId], references: [id])
  nodeId String
  profile String
  workload String
  decision String?
  closureReason String?
  closedAt DateTime?
  paymentStatus String @default("WAITING")
  isTestOrder Boolean @default(false)
  userUnread Boolean @default(false)
  status String @default("REQUESTED")
  idempotencyKey String
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  @@unique([userId, idempotencyKey])
  @@index([userId, createdAt])
  @@index([paymentStatus, status, createdAt])
}
model Ticket {
  @@index([status, createdAt])
  id String @id @default(uuid())
  userId String
  user User @relation(fields: [userId], references: [id])
  category String @default("QUESTION")
  subject String @default("Обращение")
  status String @default("OPEN")
  message String
  reply String?
  ownerUnread Boolean @default(true)
  userUnread Boolean @default(false)
  lastMessageAt DateTime @default(now())
  closedAt DateTime?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  messages TicketMessage[]
  @@index([userId, createdAt])
  @@index([status, lastMessageAt])
}
model TicketMessage {
  id String @id @default(uuid()) @db.Uuid
  ticketId String @map("ticket_id")
  ticket Ticket @relation(fields: [ticketId], references: [id], onDelete: Cascade)
  authorType String @map("author_type")
  authorId String @map("author_id")
  body String
  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(3)
  @@index([ticketId, createdAt, id])
  @@map("ticket_messages")
}
model LedgerEntry {
  id String @id @default(uuid())
  userId String
  user User @relation(fields: [userId], references: [id])
  amountMicros BigInt
  kind String
  sourceId String @unique
  createdAt DateTime @default(now())
  @@index([userId, createdAt])
}
model Audit {
  id String @id @default(uuid())
  actorId String
  action String
  targetId String
  createdAt DateTime @default(now())
}
model Invite {
  telegramId String @id
  referrerId String
  createdAt DateTime @default(now())
}
model BotUpdate {
  id BigInt @id
  createdAt DateTime @default(now())
}
model BrowserLogin {
  id String @id @db.Uuid
  secretHash String @map("secret_hash") @db.VarChar(64)
  ipHash String @map("ip_hash") @db.VarChar(64)
  telegramId String? @map("telegram_id")
  status String @default("PENDING")
  expiresAt DateTime @map("expires_at") @db.Timestamptz(3)
  consumedAt DateTime? @map("consumed_at") @db.Timestamptz(3)
  @@index([ipHash])
  @@index([expiresAt])
  @@map("browser_logins")
}
model GpuCatalog {
  id String @id @db.VarChar(64)
  name String @db.VarChar(255)
  category String
  tierLevel Int @map("tier_level")
  chip String
  precisionLabel String @map("precision_label")
  workload String
  priceUsdt Decimal @map("price_usdt") @db.Decimal(18, 2)
  dailyYieldPercent Decimal @map("daily_yield_percent") @db.Decimal(5, 2)
  compoundBoostPercent Decimal? @map("compound_boost_percent") @db.Decimal(5, 2)
  tflopsPower Int @map("tflops_power")
  totalSupply Int @default(0) @map("total_supply")
  availableSupply Int @default(0) @map("available_supply")
  supplyKnown Boolean @default(false) @map("supply_known")
  contractDays Int @map("contract_days")
  maxPerUser Int @map("max_per_user")
  imageUrl String @map("image_url") @db.VarChar(512)
  isActive Boolean @default(true) @map("is_active")
  isExperimental Boolean @default(false) @map("is_experimental")
  contractReference String? @map("contract_reference")
  leases UserLease[]
  selectedBy User[] @relation("SelectedTariff")
  @@map("gpu_catalog")
}

model OfferAcceptance {
  id String @id @default(uuid()) @db.Uuid
  userId String @map("user_id")
  user User @relation(fields: [userId], references: [id])
  version String @db.VarChar(64)
  documentSha256 String @map("document_sha256") @db.VarChar(64)
  clientHash String @map("client_hash") @db.VarChar(64)
  acceptedAt DateTime @default(now()) @map("accepted_at") @db.Timestamptz(3)
  @@unique([userId, version])
  @@index([acceptedAt])
  @@map("offer_acceptances")
}
model UserLease {
  id String @id @default(uuid()) @db.Uuid
  userId String @map("user_id")
  user User @relation(fields: [userId], references: [id])
  nodeId String @map("node_id") @db.VarChar(64)
  node GpuCatalog @relation(fields: [nodeId], references: [id])
  purchasePrice Decimal @map("purchase_price") @db.Decimal(18, 2)
  dailyYieldUsdt Decimal @map("daily_yield_usdt") @db.Decimal(18, 4)
  contractReference String @map("contract_reference")
  idempotencyKey String @map("idempotency_key") @db.Uuid
  status String @default("PROVISIONING")
  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(3)
  expiresAt DateTime @map("expires_at") @db.Timestamptz(3)
  lastYieldCalc DateTime @default(now()) @map("last_yield_calc") @db.Timestamptz(3)
  @@unique([userId, idempotencyKey])
  @@index([userId, nodeId, status])
  @@map("user_leases")
}

model TonWallet {
  id String @id @default(uuid()) @db.Uuid
  userId String @unique @map("user_id")
  user User @relation(fields: [userId], references: [id])
  network String @default("TON")
  address String @unique @db.VarChar(70)
  walletApp String? @map("wallet_app") @db.VarChar(100)
  publicKey String? @map("public_key") @db.VarChar(64)
  walletVersion String? @map("wallet_version") @db.VarChar(20)
  walletId String? @map("wallet_id") @db.VarChar(10)
  verified Boolean @default(true)
  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(3)
  lastConnectedAt DateTime @default(now()) @map("last_connected_at") @db.Timestamptz(3)
  @@map("user_wallets")
}

model TonProofChallenge {
  id String @id @default(uuid()) @db.Uuid
  userId String @map("user_id")
  user User @relation(fields: [userId], references: [id])
  nonceHash String @unique @map("nonce_hash") @db.VarChar(64)
  expiresAt DateTime @map("expires_at") @db.Timestamptz(3)
  consumedAt DateTime? @map("consumed_at") @db.Timestamptz(3)
  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(3)
  @@index([userId, createdAt])
  @@map("ton_proof_challenges")
}

model TonDeposit {
  id String @id @default(uuid()) @db.Uuid
  invoiceId String @unique @map("invoice_id") @db.VarChar(64)
  userId String @map("user_id")
  user User @relation(fields: [userId], references: [id])
  network String @default("TON")
  asset String @default("USDT")
  senderAddress String @map("sender_address") @db.VarChar(70)
  recipientAddress String @map("recipient_address") @db.VarChar(70)
  jettonMaster String @map("jetton_master") @db.VarChar(70)
  requestedMicros BigInt @map("requested_micros")
  receivedMicros BigInt? @map("received_micros")
  status String @default("PENDING") @db.VarChar(32)
  txHash String? @unique @map("tx_hash") @db.VarChar(64)
  traceId String? @map("trace_id")
  queryId String @map("query_id") @db.VarChar(24)
  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(3)
  expiresAt DateTime @map("expires_at") @db.Timestamptz(3)
  detectedAt DateTime? @map("detected_at") @db.Timestamptz(3)
  confirmedAt DateTime? @map("confirmed_at") @db.Timestamptz(3)
  creditedAt DateTime? @map("credited_at") @db.Timestamptz(3)
  ownerNotifiedAt DateTime? @map("owner_notified_at") @db.Timestamptz(3)
  metadata Json @default("{}") @db.JsonB
  ledger WalletLedger?
  @@index([userId, createdAt])
  @@index([status, expiresAt])
  @@map("deposits")
}

model WalletLedger {
  id String @id @default(uuid()) @db.Uuid
  userId String @map("user_id")
  user User @relation(fields: [userId], references: [id])
  depositId String @unique @map("deposit_id") @db.Uuid
  deposit TonDeposit @relation(fields: [depositId], references: [id])
  type String @default("DEPOSIT")
  asset String @default("USDT")
  amountMicros BigInt @map("amount_micros")
  balanceBefore BigInt @map("balance_before")
  balanceAfter BigInt @map("balance_after")
  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(3)
  metadata Json @default("{}") @db.JsonB
  @@index([userId, createdAt])
  @@map("wallet_ledger")
}

model TonWatcherCursor {
  id String @id @db.VarChar(30)
  lastUtime Int @map("last_utime")
  updatedAt DateTime @updatedAt @map("updated_at") @db.Timestamptz(3)
  @@map("ton_watcher_cursors")
}

model UnmatchedTonDeposit {
  id String @id @default(uuid()) @db.Uuid
  txHash String @unique @map("tx_hash") @db.VarChar(64)
  invoiceId String? @map("invoice_id") @db.VarChar(64)
  senderAddress String? @map("sender_address") @db.VarChar(70)
  amountMicros BigInt? @map("amount_micros")
  reason String @db.VarChar(100)
  traceId String? @map("trace_id")
  detectedAt DateTime @default(now()) @map("detected_at") @db.Timestamptz(3)
  metadata Json @default("{}") @db.JsonB
  @@index([detectedAt])
  @@map("unmatched_ton_deposits")
}
