[Unit]
Description=AetherMind Ambassador Network settlement
After=network-online.target postgresql.service
[Service]
Type=oneshot
User=deploy
Group=deploy
WorkingDirectory=/srv/apps/gpunode/current
EnvironmentFile=/srv/apps/gpunode/shared/runtime.env
EnvironmentFile=/srv/apps/gpunode/shared/public-release.env
Environment=TZ=UTC
Environment=NODE_OPTIONS=--max-old-space-size=256
ExecStart=@NODE@ /srv/apps/gpunode/current/backend/dist/network-worker.js
TimeoutStartSec=240
UMask=0077
NoNewPrivileges=true
PrivateTmp=true
