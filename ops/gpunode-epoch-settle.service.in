[Unit]
Description=AetherMind deterministic Epoch settlement
After=network-online.target postgresql.service
Wants=network-online.target

[Service]
Type=oneshot
User=deploy
Group=deploy
WorkingDirectory=/srv/apps/gpunode/current
EnvironmentFile=/srv/apps/gpunode/shared/runtime.env
ExecStart=@NODE_BIN@ backend/dist/epoch-settle.js
TimeoutStartSec=180
NoNewPrivileges=true
PrivateTmp=true
ProtectHome=true
